{
    "name": "bluefang05/php-legacy-refactor",
    "description": "Refactor a legacy PHP billing report under characterization tests, with a parity harness that proves behaviour did not change.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        },
        "files": [
            "src/Legacy/legacy_report.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "demo": "php bin/demo.php"
    },
    "config": {
        "sort-packages": true
    }
}
